# Pretty project URLs → same index.html (URL stays /demo, /proyecto1, …)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # TEMPORARY: no platform landing yet — / → /demo (remove when landing exists)
  RewriteRule ^$ /demo [R=302,L]

  # Canonicalize /demo/ → /demo (safe with absolute /js /css assets)
  RewriteCond %{REQUEST_URI} !^/(admin|auth|css|js|supabase|assets|images)/
  RewriteRule ^([A-Za-z0-9_-]+)/$ /$1 [R=301,L]

  # Serve real files and directories as-is
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # App folders that are not project slugs
  RewriteRule ^(admin|auth|css|js|supabase|assets|images)(/|$) - [L]

  # /demo, /proyecto1, … → index.html (internal rewrite, browser URL unchanged)
  RewriteRule ^([A-Za-z0-9_-]+)/?$ index.html [L]
</IfModule>

# HTML always revalidated; versioned JS/CSS can be cached long (busted by BUILD_VERSION)
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
