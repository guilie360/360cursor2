# Pretty project URLs → same index.html (URL stays /demo, /proyecto1, …)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # TEMPORARY: no platform landing yet — / → /demo1 (remove when landing exists)
  RewriteRule ^$ /demo1 [R=302,L]

  # Legacy slug alias after rename demo → demo1
  RewriteRule ^demo/?$ /demo1 [R=302,L]

  # Serve real files and directories as-is
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # App folders that are not project slugs
  RewriteRule ^(admin|admin2|auth|css|js|supabase|assets|images)(/|$) - [L]

  # /demo, /proyecto1, … → index.html (internal rewrite, browser URL unchanged)
  RewriteRule ^([A-Za-z0-9_-]+)/?$ index.html [L]
</IfModule>
